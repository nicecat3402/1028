# Copy to deploy/.env on the server. Never commit the filled file.
# Use a 64-character hex password to avoid URL-encoding ambiguity in the DB connection string.
DB_PASSWORD=
APP_ORIGIN=https://omnicard.internal.example
# Full bge-m3 digest from GET http://127.0.0.1:11434/api/tags, not the short ollama list ID.
EMBEDDING_DIGEST=
